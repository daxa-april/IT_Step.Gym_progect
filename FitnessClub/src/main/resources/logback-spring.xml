<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Консоль - всё -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- чистые логи без мусора -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/api-business.log</file>

        <!-- Ротация: новый файл каждый день или при достижении размера 10МБ -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/archived/api-business-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>

        <encoder>
            <!-- Шаблон: Дата Время + Сообщение -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%-5level] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Системные логи в консоль -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Логи из пакета в консоль, и в файл -->
    <logger name="com.Itstep.FitnessClub.service.impl" level="DEBUG" additivity="true">
        <appender-ref ref="FILE"/>
    </logger>

</configuration>
